    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Shown by macOS when the app first asks for Bluetooth.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DroidHarbor uses Bluetooth to notice when a nearby Android device starts sharing, so this Mac shows up in its share sheet faster."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DroidHarbor usa Bluetooth para detectar cuándo un dispositivo Android cercano empieza a compartir, así este Mac aparece antes en su menú de compartir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DroidHarbor utilise le Bluetooth pour détecter qu’un appareil Android proche commence un partage, afin que ce Mac apparaisse plus vite dans sa feuille de partage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DroidHarbor usa il Bluetooth per accorgersi quando un dispositivo Android vicino inizia a condividere, così questo Mac compare prima nel suo menu di condivisione."
          }
        }
      }
    },
    "NSHumanReadableCopyright" : {
      "comment" : "Copyright (human-readable)",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
