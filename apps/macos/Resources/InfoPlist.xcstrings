        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Shown by macOS when the app first looks for devices on the network.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DroidHarbor finds nearby Android devices on your local network and transfers files directly with them, without going through the internet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DroidHarbor encuentra dispositivos Android cercanos en tu red local y transfiere archivos directamente con ellos, sin pasar por internet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DroidHarbor trouve les appareils Android proches sur votre réseau local et échange les fichiers directement avec eux, sans passer par internet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DroidHarbor trova i dispositivi Android vicini sulla rete locale e trasferisce i file direttamente con loro, senza passare da internet."
          }
        }
      }
    }
  },
  "version" : "1.1"
