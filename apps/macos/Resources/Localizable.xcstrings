    "If it is missing, open **System Settings → General → Login Items & Extensions** and turn the DroidHarbor **extension** on." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si no aparece, abre **Ajustes del Sistema → General → Ítems de inicio y extensiones** y activa la **extensión** de DroidHarbor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'il est absent, ouvrez **Réglages Système → Général → Ouverture et extensions** et activez l'**extension** DroidHarbor."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se non compare, apri **Impostazioni di Sistema → Generali → Elementi login ed estensioni** e attiva l'**estensione** di DroidHarbor."
          }
        }
      }
    },
    "If it is missing, open **System Settings → Keyboard → Keyboard Shortcuts → Services** and tick *Send with DroidHarbor*." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si no aparece, abre **Ajustes del Sistema → Teclado → Funciones rápidas de teclado → Servicios** y marca *Enviar con DroidHarbor*."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'il est absent, ouvrez **Réglages Système → Clavier → Raccourcis clavier → Services** et cochez *Envoyer avec DroidHarbor*."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se non compare, apri **Impostazioni di Sistema → Tastiera → Abbreviazioni da tastiera → Servizi** e seleziona *Invia con DroidHarbor*."
          }
        }
      }
    },
