    "On the phone, open **Quick Share** (Settings → Connected devices, or the Files app) so it becomes visible." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el teléfono, abre **Quick Share** (Ajustes → Dispositivos conectados, o la app Archivos) para que sea visible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur le téléphone, ouvrez **Quick Share** (Réglages → Appareils connectés, ou l'app Fichiers) pour le rendre visible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sul telefono, apri **Quick Share** (Impostazioni → Dispositivi connessi, o l'app File) per renderlo visibile."
          }
