    "Drag files, links or text onto the menu-bar icon, or use the Send tab." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra archivos, enlaces o texto al icono de la barra de menús, o usa la pestaña Enviar."
          }
        },
