    },
    "On the phone: pick files → **Share** → **Quick Share** → tap this Mac." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el teléfono: elige archivos → **Compartir** → **Quick Share** → toca este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
