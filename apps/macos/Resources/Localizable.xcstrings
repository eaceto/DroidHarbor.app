    "DroidHarbor adds itself to Finder's Services menu." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DroidHarbor se añade al menú Servicios del Finder."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DroidHarbor s'ajoute au menu Services du Finder."
